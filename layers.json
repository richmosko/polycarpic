{
  "version": 1,
  "layers": { "0": "Platform", "1": "Identity", "2": "Sources", "3": "Books", "4": "Posting", "5": "Insight", "6": "Delivery" },
  "packages": {
    "db":         { "dir": "packages/db",         "name": "@poly/db",         "layer": 0, "subpaths": ["./session", "./auth"], "allow": [] },
    "config":     { "dir": "packages/config",     "name": "@poly/config",     "layer": 0, "subpaths": [], "allow": [] },
    "auth":       { "dir": "packages/auth",       "name": "@poly/auth",       "layer": 1, "subpaths": [], "allow": ["db", "db/auth", "db/session", "tenancy"] },
    "tenancy":    { "dir": "packages/tenancy",    "name": "@poly/tenancy",    "layer": 1, "subpaths": [], "allow": ["db"] },
    "secrets":    { "dir": "packages/secrets",    "name": "@poly/secrets",    "layer": 1, "subpaths": ["./open"], "allow": [] },
    "import":     { "dir": "packages/import",     "name": "@poly/import",     "layer": 2, "subpaths": [], "allow": ["db", "secrets"] },
    "refdata":    { "dir": "packages/refdata",    "name": "@poly/refdata",    "layer": 2, "subpaths": [], "allow": ["db"] },
    "ledger":     { "dir": "packages/ledger",     "name": "@poly/ledger",     "layer": 3, "subpaths": [], "allow": ["db", "tenancy"] },
    "securities": { "dir": "packages/securities", "name": "@poly/securities", "layer": 3, "subpaths": [], "allow": ["db", "ledger", "refdata"] },
    "posting":    { "dir": "packages/posting",    "name": "@poly/posting",    "layer": 4, "subpaths": [], "allow": ["db", "import", "ledger", "securities"] },
    "reports":    { "dir": "packages/reports",    "name": "@poly/reports",    "layer": 5, "subpaths": [], "allow": ["db", "ledger", "securities", "portfolio", "tax"] },
    "tax":        { "dir": "packages/tax",        "name": "@poly/tax",        "layer": 5, "subpaths": [], "allow": ["db", "ledger", "refdata", "tenancy"] },
    "portfolio":  { "dir": "packages/portfolio",  "name": "@poly/portfolio",  "layer": 5, "subpaths": [], "allow": ["db", "ledger", "securities", "refdata"] },
    "ui":         { "dir": "packages/ui",         "name": "@poly/ui",         "layer": 6, "subpaths": [], "allow": [] },
    "web":        { "dir": "apps/web",            "name": "@poly/web",        "layer": 6, "subpaths": [], "allow": ["config", "db", "auth", "tenancy", "secrets", "import", "refdata", "ledger", "securities", "posting", "reports", "tax", "portfolio", "ui"] },
    "worker":     { "dir": "apps/worker",         "name": "@poly/worker",     "layer": 6, "subpaths": [], "allow": ["config", "db", "secrets", "secrets/open", "import", "refdata", "securities", "posting", "tax"] }
  },
  "sessionSetExempt": "packages/db/src/migrate.ts"
}
