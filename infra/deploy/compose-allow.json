     "read_only": true,
     "secrets": {
      "backup_store_credential__uploader": "/etc/polycarpic/secrets/uploader/backup_store_credential"
     },
     "security_opt": [
      "no-new-privileges:true"
     ],
     "user": "10005:10005"
    },
    "web": {
     "env_files": [
      "/etc/polycarpic/host.env"
