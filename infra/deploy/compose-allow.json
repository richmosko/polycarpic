{
 "projects": {
  "edge": {
   "networks": {
    "edge-prod": {
     "external": true,
     "ipam": {},
     "name": "polycarpic-edge-prod"
    },
    "edge-staging": {
     "external": true,
     "ipam": {},
     "name": "polycarpic-edge-staging"
    }
   },
   "services": {
    "caddy": {
     "binds": [
      {
       "read_only": false,
       "source": "/srv/polycarpic/caddy",
       "target": "/data"
      },
      {
       "read_only": false,
       "source": "/srv/polycarpic/caddy-config",
       "target": "/config"
      }
     ],
     "image": "caddy",
     "keys": [
      "cap_drop",
      "command",
      "entrypoint",
      "environment",
      "healthcheck",
      "image",
      "mem_limit",
      "networks",
      "ports",
      "read_only",
      "restart",
      "secrets",
      "security_opt",
      "tmpfs",
      "user",
      "volumes"
     ],
     "networks": {
      "edge-prod": [],
      "edge-staging": []
     },
     "ports": [
      {
       "protocol": "tcp",
       "published": "80",
       "target": 8080
      },
      {
       "protocol": "tcp",
       "published": "443",
       "target": 8443
      }
     ],
     "read_only": true,
     "secrets": {
      "staging_basic_auth__caddy": "/etc/polycarpic/secrets/caddy/staging_basic_auth"
     },
     "security_opt": [
      "no-new-privileges:true"
     ],
     "user": "10010:10010"
    }
   }
  },
  "prod": {
   "networks": {
    "backup-net": {
     "internal": true,
     "ipam": {
      "config": [
       {
        "subnet": "10.201.10.0/29"
       }
      ]
     },
     "name": "polycarpic-prod_backup-net"
    },
    "default": {
     "ipam": {
      "config": [
       {
        "subnet": "10.201.1.0/24"
       }
      ]
     },
     "name": "polycarpic-prod_default"
    },
    "edge-prod": {
     "external": true,
     "ipam": {},
     "name": "polycarpic-edge-prod"
    },
    "upload-net": {
     "ipam": {
      "config": [
       {
        "subnet": "10.201.20.0/29"
       }
      ]
     },
     "name": "polycarpic-prod_upload-net"
    }
   },
   "services": {
    "auth": {
     "env_files": [
      "/etc/polycarpic/host.env"
     ],
     "image": "app",
     "keys": [
      "cap_drop",
      "command",
      "entrypoint",
      "env_file",
      "environment",
      "healthcheck",
      "image",
      "mem_limit",
      "networks",
      "read_only",
      "restart",
      "secrets",
      "security_opt",
      "tmpfs",
      "ulimits",
      "user"
     ],
     "networks": {
      "default": [],
      "edge-prod": [
       "prod-auth"
      ]
     },
     "read_only": true,
     "secrets": {
      "auth_secret__auth": "/etc/polycarpic/secrets/auth/auth_secret",
      "db_password_auth__auth": "/etc/polycarpic/secrets/auth/db_password_auth",
      "resend_api_key__auth": "/etc/polycarpic/secrets/auth/resend_api_key"
     },
     "security_opt": [
      "no-new-privileges:true"
     ],
     "user": "10007:10007"
    },
    "backup": {
     "binds": [
      {
       "read_only": true,
       "source": "@release/infra/backup/backup.sh",
       "target": "/usr/local/bin/backup.sh"
      },
      {
       "read_only": false,
       "source": "/srv/polycarpic/spool/dump",
       "target": "/spool/dump"
      },
      {
       "read_only": false,
       "source": "/srv/polycarpic/spool/premigration",
       "target": "/spool/premigration"
      },
      {
       "read_only": true,
       "source": "/etc/polycarpic/age-recipients.txt",
       "target": "/etc/backup/age-recipients.txt"
      }
     ],
     "image": "postgres",
     "keys": [
      "cap_drop",
      "command",
      "entrypoint",
      "environment",
      "healthcheck",
      "image",
      "mem_limit",
      "networks",
      "profiles",
      "read_only",
      "restart",
      "secrets",
      "security_opt",
      "tmpfs",
      "ulimits",
      "user",
      "volumes"
     ],
     "networks": {
      "backup-net": []
     },
     "read_only": true,
     "secrets": {
      "db_password_backup__backup": "/etc/polycarpic/secrets/backup/db_password_backup"
     },
     "security_opt": [
      "no-new-privileges:true"
     ],
     "user": "10004:10004"
    },
    "migrate": {
     "env_files": [
      "/etc/polycarpic/host.env"
     ],
     "image": "app",
     "keys": [
      "cap_drop",
      "command",
      "entrypoint",
      "env_file",
      "environment",
      "healthcheck",
      "image",
      "mem_limit",
      "networks",
      "profiles",
      "read_only",
      "restart",
      "secrets",
      "security_opt",
      "tmpfs",
      "ulimits",
      "user"
     ],
     "networks": {
      "default": []
     },
     "read_only": true,
     "secrets": {
      "db_password_migrator__migrate": "/etc/polycarpic/secrets/migrate/db_password_migrator"
     },
     "security_opt": [
      "no-new-privileges:true"
     ],
     "user": "10003:10003"
    },
    "operator": {
     "env_files": [
      "/etc/polycarpic/host.env"
     ],
     "image": "app",
     "keys": [
      "cap_drop",
      "command",
      "entrypoint",
      "env_file",
      "environment",
      "healthcheck",
      "image",
      "logging",
      "mem_limit",
      "networks",
      "profiles",
      "read_only",
      "restart",
      "secrets",
      "security_opt",
      "tmpfs",
      "ulimits",
      "user"
     ],
     "networks": {
      "default": []
     },
     "read_only": true,
     "secrets": {
      "db_password_operator__operator": "/etc/polycarpic/secrets/operator/db_password_operator"
     },
     "security_opt": [
      "no-new-privileges:true"
     ],
     "user": "10006:10006"
    },
    "postgres": {
     "binds": [
      {
       "read_only": false,
       "source": "/srv/polycarpic/pg-prod",
       "target": "/var/lib/postgresql/data"
      },
      {
       "read_only": true,
       "source": "@release/infra/postgres/postgresql.prod.conf",
       "target": "/etc/postgresql/postgresql.conf"
      },
      {
       "read_only": true,
       "source": "@release/infra/postgres/pg_hba.prod.conf",
       "target": "/etc/postgresql/pg_hba.conf"
      },
      {
       "read_only": true,
       "source": "@release/infra/postgres/archive-wal.sh",
       "target": "/usr/local/bin/archive-wal.sh"
      },
      {
       "read_only": true,
       "source": "/etc/polycarpic/age-recipients.txt",
       "target": "/etc/postgresql/age-recipients.txt"
      },
      {
       "read_only": false,
       "source": "/srv/polycarpic/spool/wal",
       "target": "/spool/wal"
      }
     ],
     "image": "postgres",
     "keys": [
      "cap_drop",
      "command",
      "entrypoint",
      "environment",
      "healthcheck",
      "image",
      "mem_limit",
      "networks",
      "read_only",
      "restart",
      "secrets",
      "security_opt",
      "tmpfs",
      "ulimits",
      "user",
      "volumes"
     ],
     "networks": {
      "backup-net": [],
      "default": []
     },
     "read_only": true,
     "secrets": {
      "db_superuser_password__postgres": "/etc/polycarpic/secrets/postgres/db_superuser_password"
     },
     "security_opt": [
      "no-new-privileges:true"
     ],
     "user": "999:999"
    },
    "uploader": {
     "binds": [
      {
       "read_only": true,
       "source": "@release/infra/backup/upload.sh",
       "target": "/usr/local/bin/upload.sh"
      },
      {
       "read_only": true,
       "source": "/srv/polycarpic/spool",
       "target": "/spool"
      },
      {
       "read_only": true,
       "source": "/etc/polycarpic/ops.conf",
       "target": "/etc/uploader/ops.conf"
      },
      {
       "read_only": true,
       "source": "/etc/polycarpic/host.env",
       "target": "/etc/uploader/host.env"
      }
     ],
     "image": "tools",
     "keys": [
      "cap_drop",
      "command",
      "entrypoint",
      "healthcheck",
      "image",
      "mem_limit",
      "networks",
      "profiles",
      "read_only",
      "restart",
      "secrets",
      "security_opt",
      "tmpfs",
      "ulimits",
      "user",
      "volumes"
     ],
     "networks": {
      "upload-net": []
