{
  "renderEnv": {
    "POLY_BIND_ADDR": "192.0.2.1",
    "POLY_DOMAIN": "lint.test",
    "POLY_STAGING_ALLOW": "192.0.2.0/24"
  },
  "allowedVars": [
    "POLY_POSTGRES_IMAGE", "POLY_APP_IMAGE", "POLY_TOOLS_IMAGE", "POLY_CADDY_IMAGE",
    "POLY_BIND_ADDR", "POLY_DOMAIN", "POLY_STAGING_ALLOW"
  ],
  "secretMatrix": {
    "prod": {
      "db_superuser_password": ["postgres"],
      "db_password_app": ["web"],
      "db_password_worker": ["worker"],
      "db_password_migrator": ["migrate"],
      "db_password_backup": ["backup"],
      "auth_secret": ["web", "worker"],
      "resend_api_key": ["web", "worker"],
      "plaid_secret": ["web"],
      "credential_keyring": ["worker"],
      "backup_store_credential": ["uploader"],
      "heartbeat_url": ["uploader"]
    },
    "staging": {
      "db_superuser_password": ["postgres"],
      "db_password_app": ["web"],
      "db_password_worker": ["worker"],
      "db_password_migrator": ["migrate"],
      "auth_secret": ["web", "worker"],
      "resend_api_key": ["web", "worker"],
      "plaid_secret": ["web"],
      "credential_keyring": ["worker"]
    },
    "edge": {
      "staging_basic_auth": ["caddy"]
    }
  },
  "secretPrefix": {
    "prod": "/etc/polycarpic/secrets/",
    "staging": "/etc/polycarpic/staging-secrets/",
    "edge": "/etc/polycarpic/secrets/"
  },
  "binds": {
    "postgres": [
      { "source": "/srv/polycarpic/pg-prod", "target": "/var/lib/postgresql/data", "rw": true },
      { "source": "/srv/polycarpic/pg-staging", "target": "/var/lib/postgresql/data", "rw": true },
      { "source": "../postgres/postgresql.prod.conf", "target": "/etc/postgresql/postgresql.conf" },
      { "source": "../postgres/postgresql.staging.conf", "target": "/etc/postgresql/postgresql.conf" },
      { "source": "../postgres/pg_hba.prod.conf", "target": "/etc/postgresql/pg_hba.conf" },
      { "source": "../postgres/pg_hba.staging.conf", "target": "/etc/postgresql/pg_hba.conf" },
      { "source": "../postgres/archive-wal.sh", "target": "/usr/local/bin/archive-wal.sh" },
      { "source": "/etc/polycarpic/age-recipients.txt", "target": "/etc/postgresql/age-recipients.txt" },
      { "source": "/srv/polycarpic/spool/wal", "target": "/spool/wal", "rw": true }
    ],
    "backup": [
      { "source": "/srv/polycarpic/spool", "target": "/spool", "rw": true },
      { "source": "/etc/polycarpic/age-recipients.txt", "target": "/etc/backup/age-recipients.txt" }
    ],
    "uploader": [
      { "source": "/srv/polycarpic/spool", "target": "/spool", "rw": true },
      { "source": "/srv/polycarpic/uploader-state", "target": "/state", "rw": true }
    ],
    "caddy": [
      { "source": "/srv/polycarpic/caddy", "target": "/data", "rw": true },
      { "source": "/srv/polycarpic/caddy-config", "target": "/config", "rw": true },
      { "source": "../caddy/Caddyfile", "target": "/etc/caddy/Caddyfile" }
    ]
  }
}
