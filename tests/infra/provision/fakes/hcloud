#!/usr/bin/env python3
"""Stateful fake `hcloud` (R3). State: $FAKE_STATE/hcloud.json. Every call is appended to $FAKE_STATE/calls.log, with the
user-data file of `server create` copied to $FAKE_STATE/user-data.yaml. `-o json` shapes follow the hcloud CLI's documented
output. A verb this fake does not know exits 99 so the gap is visible. Never talks to a network."""
import json, os, shlex, sys

S = os.environ.get("FAKE_STATE", "/var/fake-state")
os.makedirs(S, exist_ok=True)
STATE = os.path.join(S, "hcloud.json")
argv = sys.argv[1:]
with open(os.path.join(S, "calls.log"), "a") as f:
    f.write("hcloud " + " ".join(shlex.quote(a) for a in argv) + "\n")

DEFAULT = {"next": 1, "ssh_keys": [], "firewalls": [], "servers": [], "volumes": [],
           "context": None,
           "server_types": [
               {"name": "cpx31", "cores": 4, "memory": 8, "disk": 160, "cpu_type": "shared", "architecture": "x86", "description": "CPX 31"},
               {"name": "cx32", "cores": 4, "memory": 8, "disk": 80, "cpu_type": "shared", "architecture": "x86", "description": "CX 32"},
               {"name": "cax21", "cores": 4, "memory": 8, "disk": 80, "cpu_type": "shared", "architecture": "arm", "description": "CAX 21"},
               {"name": "ccx13", "cores": 2, "memory": 8, "disk": 80, "cpu_type": "dedicated", "architecture": "x86", "description": "CCX 13"}]}
st = json.load(open(STATE)) if os.path.exists(STATE) else json.loads(json.dumps(DEFAULT))


def save():
    json.dump(st, open(STATE, "w"), indent=1)


def nid():
    st["next"] += 1
    return 1000000 + st["next"] * 7


def opts(args, flags_with_value):
    pos, kv, multi = [], {}, {}
    i = 0
    while i < len(args):
        a = args[i]
        if a.startswith("--") and "=" in a:
            k, v = a[2:].split("=", 1); kv[k] = v; multi.setdefault(k, []).append(v)
        elif a.startswith("-o") and a != "-o":
            kv["o"] = a[2:]
        elif a.startswith("-") and a[1:].lstrip("-") in flags_with_value:
            k = a.lstrip("-"); kv[k] = args[i + 1]; multi.setdefault(k, []).append(args[i + 1]); i += 1
        elif a.startswith("-"):
            kv[a.lstrip("-")] = True
        else:
            pos.append(a)
        i += 1
    return pos, kv, multi


VALUED = {"o", "name", "type", "image", "location", "ssh-key", "firewall", "volume", "size", "label", "selector", "user-data-from-file",
          "rules-file", "server", "fingerprint", "public-key-from-file", "apply-to-server", "output", "datacenter", "format"}


def labels_of(multi):
    out = {}
    for l in multi.get("label", []):
        k, _, v = l.partition("="); out[k] = v
    return out


def sel_ok(obj, kv):
    s = kv.get("selector")
    if not s:
        return True
    k, _, v = s.partition("=")
    return obj.get("labels", {}).get(k) == v


def emit(kv, obj, human):
    if kv.get("o") == "json" or kv.get("output") == "json":
        print(json.dumps(obj, indent=1))
    else:
        print(human)


def fp_of(pub):
    import hashlib, base64
    try:
        raw = base64.b64decode(pub.split()[1])
        h = hashlib.md5(raw).hexdigest()
        return ":".join(h[i:i + 2] for i in range(0, 32, 2))
    except Exception:
        return "00:" * 15 + "00"


def die(msg, code=1):
    print(msg, file=sys.stderr); sys.exit(code)


if os.environ.get("HCLOUD_TOKEN"):
    die("FAKE: HCLOUD_TOKEN reached the fake hcloud (a token must never be in the environment)", 98)
if not argv:
    die("hcloud: no command", 2)

res, verb, rest = argv[0], (argv[1] if len(argv) > 1 else ""), argv[2:]
pos, kv, multi = opts(rest, VALUED)

if res == "context":
    if verb == "list":
        for c in ([st["context"]] if st["context"] else []):
            print(c)
        sys.exit(0)
    if verb == "active":
        print(st["context"] or ""); sys.exit(0)
    sys.exit(99)
if res == "server-type" and verb == "list":
    emit(kv, st["server_types"], "\n".join(t["name"] for t in st["server_types"])); sys.exit(0)

if res == "ssh-key":
    if verb == "list":
        emit(kv, [k for k in st["ssh_keys"] if sel_ok(k, kv)], "\n".join(k["name"] for k in st["ssh_keys"])); sys.exit(0)
    if verb == "create":
        pub = open(kv["public-key-from-file"]).read().strip()
        k = {"id": nid(), "name": kv["name"], "fingerprint": fp_of(pub), "public_key": pub, "labels": labels_of(multi)}
        st["ssh_keys"].append(k); save(); emit(kv, k, f"SSH key {k['id']} created"); sys.exit(0)
if res == "firewall":
    if verb == "list":
        emit(kv, [f for f in st["firewalls"] if sel_ok(f, kv)], "\n".join(f["name"] for f in st["firewalls"])); sys.exit(0)
    if verb == "create":
        rules = json.load(open(kv["rules-file"])) if "rules-file" in kv else []
        f = {"id": nid(), "name": kv["name"], "labels": labels_of(multi), "rules": rules, "applied_to": []}
        st["firewalls"].append(f); save(); emit(kv, {"firewall": f}, f"Firewall {f['id']} created"); sys.exit(0)
    if verb in ("describe",):
        fw = next((f for f in st["firewalls"] if f["name"] == pos[0] or str(f["id"]) == pos[0]), None)
        if not fw:
            die(f"firewall not found: {pos[0]}")
        emit(kv, fw, json.dumps(fw)); sys.exit(0)
    if verb in ("apply-to-resource", "remove-from-resource"):
        fw = next((f for f in st["firewalls"] if f["name"] == pos[0]), None)
        srv = next((x for x in st["servers"] if x["name"] == kv.get("server", "")), None)
        if not fw or not srv:
            die("firewall or server not found")
        fw["applied_to"] = [a for a in fw["applied_to"] if a.get("server", {}).get("id") != srv["id"]]
        srv["firewalls"] = [a for a in srv["firewalls"] if a["id"] != fw["id"]]
        srv["public_net"]["firewalls"] = [a for a in srv["public_net"]["firewalls"] if a["id"] != fw["id"]]
        if verb == "apply-to-resource":
            fw["applied_to"].append({"type": "server", "server": {"id": srv["id"]}})
            srv["firewalls"].append({"id": fw["id"], "status": "applied"})
            srv["public_net"]["firewalls"].append({"id": fw["id"], "status": "applied"})
        save(); print("Firewall %s" % ("applied" if verb == "apply-to-resource" else "removed")); sys.exit(0)
    if verb == "replace-rules":
        fw = next((f for f in st["firewalls"] if f["name"] == pos[0]), None)
        if not fw:
            die(f"firewall not found: {pos[0]}")
        src = kv.get("rules-file")
        raw = sys.stdin.read() if src in (None, "-") else open(src).read()
        fw["rules"] = json.loads(raw); save(); print("Firewall rules replaced"); sys.exit(0)
if res == "server":
    if verb == "list":
        emit(kv, [s for s in st["servers"] if sel_ok(s, kv)], "\n".join(s["name"] for s in st["servers"])); sys.exit(0)
    if verb == "describe":
        s = next((s for s in st["servers"] if s["name"] == pos[0]), None)
        if not s:
            die(f"server not found: {pos[0]}")
        emit(kv, s, json.dumps(s)); sys.exit(0)
    if verb == "create":
        for need in ("name", "type", "image"):
            if need not in kv:
                die(f"hcloud: missing --{need}", 2)
        if "user-data-from-file" in kv:
            open(os.path.join(S, "user-data.yaml"), "w").write(open(kv["user-data-from-file"]).read())
        sid = nid()
        s = {"id": sid, "name": kv["name"], "labels": labels_of(multi), "image": {"name": kv["image"]},
             "server_type": {"name": kv["type"]}, "datacenter": {"location": {"name": kv.get("location", "nbg1")}},
             "public_net": {"ipv4": {"ip": "203.0.113.7"}, "ipv6": {"ip": "2001:db8:1::/64"}, "firewalls": []}, "volumes": [], "firewalls": []}
        for fwn in multi.get("firewall", []):
            fw = next((f for f in st["firewalls"] if f["name"] == fwn), None)
            if not fw:
                die(f"firewall not found: {fwn}")
            fw["applied_to"].append({"type": "server", "server": {"id": sid}}); s["firewalls"].append({"id": fw["id"], "status": "applied"}); s["public_net"]["firewalls"].append({"id": fw["id"], "status": "applied"})
        for vn in multi.get("volume", []):
            v = next((v for v in st["volumes"] if v["name"] == vn), None)
            if v:
                v["server"] = sid; s["volumes"].append(v["id"])
        st["servers"].append(s); save(); emit(kv, {"server": s}, f"Server {sid} created"); sys.exit(0)
if res == "volume":
    if verb == "list":
        emit(kv, [v for v in st["volumes"] if sel_ok(v, kv)], "\n".join(v["name"] for v in st["volumes"])); sys.exit(0)
    if verb == "create":
        srv = None
        if "server" in kv:
            srv = next((s for s in st["servers"] if s["name"] == kv["server"]), None)
        v = {"id": nid(), "name": kv["name"], "size": int(kv.get("size", 0)), "labels": labels_of(multi), "server": srv["id"] if srv else None,
             "format": kv.get("format")}
        if srv:
            srv["volumes"].append(v["id"])
        st["volumes"].append(v); save(); emit(kv, {"volume": v}, f"Volume {v['id']} created"); sys.exit(0)
    if verb == "attach":
        v = next((v for v in st["volumes"] if v["name"] == pos[0]), None)
        s = next((s for s in st["servers"] if s["name"] == kv.get("server", "")), None)
        if not v or not s:
            die("volume or server not found")
        v["server"] = s["id"]; s["volumes"].append(v["id"]); save(); print("Volume attached"); sys.exit(0)
    if verb == "describe":
        v = next((v for v in st["volumes"] if v["name"] == pos[0]), None)
        if not v:
            die(f"volume not found: {pos[0]}")
        emit(kv, v, json.dumps(v)); sys.exit(0)

print(f"FAKE: unsupported hcloud {' '.join(argv)}", file=sys.stderr)
sys.exit(99)
