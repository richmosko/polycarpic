{
  "name": "polycarpic-edge",
  "networks": {
    "backup-net": {
      "internal": true,
      "ipam": {
        "config": [
          {
            "subnet": "10.201.10.0/29"
          }
        ]
      }
    },
    "default": {
      "ipam": {
        "config": [
          {
            "subnet": "10.201.1.0/24"
          }
        ]
      },
      "name": "polycarpic-prod_default"
    },
    "edge-prod": {
      "external": true,
      "ipam": {
        "config": [
          {
            "subnet": "10.201.30.0/28"
          }
        ]
      },
      "name": "polycarpic-edge-prod"
    },
    "edge-staging": {
      "ipam": {
        "config": [
          {
            "subnet": "10.202.30.0/28"
          }
        ]
      },
      "name": "polycarpic-edge-staging"
    },
    "upload-net": {
      "ipam": {
        "config": [
          {
            "subnet": "10.201.20.0/29"
          }
        ]
      }
    }
  },
  "secrets": {
    "auth_secret__auth": {
      "file": "/etc/polycarpic/secrets/auth/auth_secret"
    },
    "backup_store_credential__uploader": {
      "file": "/etc/polycarpic/secrets/uploader/backup_store_credential"
    },
    "credential_keyring__worker": {
      "file": "/etc/polycarpic/secrets/worker/credential_keyring"
    },
    "db_password_app__web": {
      "file": "/etc/polycarpic/secrets/web/db_password_app"
    },
    "db_password_auth__auth": {
      "file": "/etc/polycarpic/secrets/auth/db_password_auth"
    },
    "db_password_backup__backup": {
      "file": "/etc/polycarpic/secrets/backup/db_password_backup"
    },
    "db_password_migrator__migrate": {
      "file": "/etc/polycarpic/secrets/migrate/db_password_migrator"
    },
    "db_password_operator__operator": {
      "file": "/etc/polycarpic/secrets/operator/db_password_operator"
    },
    "db_password_worker__worker": {
      "file": "/etc/polycarpic/secrets/worker/db_password_worker"
    },
    "db_superuser_password__postgres": {
      "file": "/etc/polycarpic/secrets/postgres/db_superuser_password"
    },
    "plaid_secret__web": {
      "file": "/etc/polycarpic/secrets/web/plaid_secret"
    },
    "resend_api_key__auth": {
      "file": "/etc/polycarpic/secrets/auth/resend_api_key"
    },
    "resend_api_key__worker": {
      "file": "/etc/polycarpic/secrets/worker/resend_api_key"
    },
    "staging_basic_auth__caddy": {
      "file": "/etc/polycarpic/secrets/caddy/staging_basic_auth"
    }
  },
  "services": {
    "auth": {
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "auth"
      ],
      "env_file": [
        {
          "path": "/etc/polycarpic/host.env",
          "required": true
        }
      ],
      "environment": {
        "APP_ENV": "production",
        "AUTH_PUBLIC_PORT": "3000",
        "AUTH_SECRET_FILE": "/run/secrets/auth_secret",
        "DATABASE_HOST": "postgres",
        "DATABASE_NAME": "polycarpic",
        "DATABASE_PASSWORD_FILE": "/run/secrets/db_password_auth",
        "DATABASE_PORT": "5432",
        "DATABASE_SSLMODE": "disable",
        "DATABASE_USER": "poly_auth",
        "PLAID_ENV": "production",
        "RESEND_API_KEY_FILE": "/run/secrets/resend_api_key"
      },
      "healthcheck": {
        "interval": "30s",
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3000/api/auth/ok',{headers:{'x-forwarded-for':'127.0.0.1'}}).then(r=\u003eprocess.exit(r.status\u003c500?0:1)).catch(()=\u003eprocess.exit(1))"
        ],
        "timeout": "5s"
      },
      "image": "${POLY_APP_IMAGE:?}",
      "mem_limit": "256m",
      "networks": {
        "default": {},
        "edge-prod": {
          "aliases": [
            "prod-auth"
          ]
        }
      },
      "read_only": true,
      "restart": "unless-stopped",
      "secrets": [
        {
          "source": "db_password_auth__auth",
          "target": "db_password_auth"
        },
        {
          "source": "auth_secret__auth",
          "target": "auth_secret"
        },
        {
          "source": "resend_api_key__auth",
          "target": "resend_api_key"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "ulimits": {
        "core": 0
      },
      "user": "10007:10007"
    },
    "backup": {
      "cap_drop": [
        "ALL"
      ],
      "environment": {
        "DB_PASSWORD_FILE": "/run/secrets/db_password_backup"
      },
      "healthcheck": {
        "interval": "60s",
        "test": [
          "CMD",
          "pg_isready",
          "-h",
          "postgres"
        ],
        "timeout": "5s"
      },
      "image": "${POLY_POSTGRES_IMAGE:?}",
      "mem_limit": "256m",
      "networks": {
        "backup-net": null
      },
      "profiles": [
        "backup"
      ],
      "read_only": true,
      "restart": "no",
      "secrets": [
        {
          "source": "db_password_backup__backup",
          "target": "db_password_backup"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp:size=1m"
      ],
      "ulimits": {
        "core": 0
      },
      "user": "10004:10004",
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "@@REL@@/infra/backup/backup.sh",
          "target": "/usr/local/bin/backup.sh",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "source": "/srv/polycarpic/spool/dump",
          "target": "/spool/dump",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "source": "/srv/polycarpic/spool/premigration",
          "target": "/spool/premigration",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "/etc/polycarpic/age-recipients.txt",
          "target": "/etc/backup/age-recipients.txt",
          "type": "bind"
        }
      ]
    },
    "caddy": {
      "cap_drop": [
        "ALL"
      ],
      "environment": {
        "POLY_DOMAIN": "${POLY_DOMAIN:?}",
        "POLY_STAGING_ALLOW": "${POLY_STAGING_ALLOW:?}",
        "POLY_TLS": "${POLY_TLS:?}"
      },
      "healthcheck": {
        "interval": "60s",
        "test": [
          "CMD",
          "caddy",
          "version"
        ],
        "timeout": "5s"
      },
      "image": "${POLY_CADDY_IMAGE:?}",
      "mem_limit": "128m",
      "networks": {
        "edge-prod": null,
        "edge-staging": null
      },
      "ports": [
        "${POLY_BIND_ADDR:?}:80:8080",
        "${POLY_BIND_ADDR:?}:443:8443"
      ],
      "read_only": true,
      "restart": "unless-stopped",
      "secrets": [
        {
          "source": "staging_basic_auth__caddy",
          "target": "staging_basic_auth"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "user": "10010:10010",
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "source": "/srv/polycarpic/caddy",
          "target": "/data",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "source": "/srv/polycarpic/caddy-config",
          "target": "/config",
          "type": "bind"
        }
      ]
    },
    "migrate": {
      "cap_drop": [
        "ALL"
      ],
      "env_file": [
        {
          "path": "/etc/polycarpic/host.env",
          "required": true
        }
      ],
      "environment": {
        "APP_ENV": "production",
        "DATABASE_HOST": "postgres",
        "DATABASE_NAME": "polycarpic",
        "DATABASE_PASSWORD_FILE": "/run/secrets/db_password_migrator",
        "DATABASE_PORT": "5432",
        "DATABASE_SSLMODE": "disable",
        "DATABASE_USER": "poly_migrator",
        "PLAID_ENV": "production"
      },
      "healthcheck": {
        "interval": "60s",
        "test": [
          "CMD",
          "node",
          "-e",
          "process.exit(0)"
        ],
        "timeout": "5s"
      },
      "image": "${POLY_APP_IMAGE:?}",
      "mem_limit": "512m",
      "networks": {
        "default": null
      },
      "profiles": [
        "migrate"
      ],
      "read_only": true,
      "restart": "no",
      "secrets": [
        {
          "source": "db_password_migrator__migrate",
          "target": "db_password_migrator"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "ulimits": {
        "core": 0
      },
      "user": "10003:10003"
    },
    "operator": {
      "cap_drop": [
        "ALL"
      ],
      "entrypoint": [
        "/app/bin/polycarpic",
        "cli"
      ],
      "env_file": [
        {
          "path": "/etc/polycarpic/host.env",
          "required": true
        }
      ],
      "environment": {
        "APP_ENV": "production",
        "DATABASE_HOST": "postgres",
        "DATABASE_NAME": "polycarpic",
        "DATABASE_PASSWORD_FILE": "/run/secrets/db_password_operator",
        "DATABASE_PORT": "5432",
        "DATABASE_SSLMODE": "disable",
        "DATABASE_USER": "poly_operator",
        "PLAID_ENV": "production"
      },
      "healthcheck": {
        "interval": "60s",
        "test": [
          "CMD",
          "node",
          "-e",
          "process.exit(0)"
        ],
        "timeout": "5s"
      },
      "image": "${POLY_APP_IMAGE:?}",
      "logging": {
        "driver": "none"
      },
      "mem_limit": "256m",
      "networks": {
        "default": null
      },
      "profiles": [
        "operator"
      ],
      "read_only": true,
      "restart": "no",
      "secrets": [
        {
          "source": "db_password_operator__operator",
          "target": "db_password_operator"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "ulimits": {
        "core": 0
      },
      "user": "10006:10006"
    },
    "postgres": {
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "postgres",
        "-c",
        "config_file=/etc/postgresql/postgresql.conf"
      ],
      "environment": {
        "POSTGRES_PASSWORD_FILE": "/run/secrets/db_superuser_password"
      },
      "healthcheck": {
        "interval": "10s",
        "retries": 6,
        "start_period": "30s",
        "test": [
          "CMD-SHELL",
          "pg_isready -U postgres -h /var/run/postgresql"
        ],
        "timeout": "5s"
      },
      "image": "${POLY_POSTGRES_IMAGE:?}",
      "mem_limit": "3g",
      "networks": {
        "backup-net": null,
        "default": null
      },
      "read_only": true,
      "restart": "unless-stopped",
      "secrets": [
        {
          "source": "db_superuser_password__postgres",
          "target": "db_superuser_password"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp",
        "/var/run/postgresql:uid=999,gid=999,mode=0755"
      ],
      "ulimits": {
        "core": 0
      },
      "user": "999:999",
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "source": "/srv/polycarpic/pg-prod",
          "target": "/var/lib/postgresql/data",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "@@REL@@/infra/postgres/postgresql.prod.conf",
          "target": "/etc/postgresql/postgresql.conf",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "@@REL@@/infra/postgres/pg_hba.prod.conf",
          "target": "/etc/postgresql/pg_hba.conf",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "@@REL@@/infra/postgres/archive-wal.sh",
          "target": "/usr/local/bin/archive-wal.sh",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "/etc/polycarpic/age-recipients.txt",
          "target": "/etc/postgresql/age-recipients.txt",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "source": "/srv/polycarpic/spool/wal",
          "target": "/spool/wal",
          "type": "bind"
        }
      ]
    },
    "uploader": {
      "cap_drop": [
        "ALL"
      ],
      "healthcheck": {
        "interval": "60s",
        "test": [
          "CMD",
          "rclone",
          "version"
        ],
        "timeout": "5s"
      },
      "image": "${POLY_TOOLS_IMAGE:?}",
      "mem_limit": "128m",
      "networks": {
        "upload-net": null
      },
      "profiles": [
        "uploader"
      ],
      "read_only": true,
      "restart": "no",
      "secrets": [
        {
          "source": "backup_store_credential__uploader",
          "target": "backup_store_credential"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp:size=1m"
      ],
      "ulimits": {
        "core": 0
      },
      "user": "10005:10005",
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "@@REL@@/infra/backup/upload.sh",
          "target": "/usr/local/bin/upload.sh",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "/srv/polycarpic/spool",
          "target": "/spool",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "/etc/polycarpic/ops.conf",
          "target": "/etc/uploader/ops.conf",
          "type": "bind"
        },
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "/etc/polycarpic/host.env",
          "target": "/etc/uploader/host.env",
          "type": "bind"
        }
      ]
    },
    "web": {
      "cap_drop": [
        "ALL"
      ],
      "env_file": [
        {
          "path": "/etc/polycarpic/host.env",
          "required": true
        }
      ],
      "environment": {
        "APP_ENV": "production",
        "DATABASE_HOST": "postgres",
        "DATABASE_NAME": "polycarpic",
        "DATABASE_PASSWORD_FILE": "/run/secrets/db_password_app",
        "DATABASE_PORT": "5432",
        "DATABASE_SSLMODE": "disable",
        "DATABASE_USER": "poly_app",
        "PLAID_ENV": "production"
      },
      "healthcheck": {
        "interval": "30s",
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3000/').then(r=\u003eprocess.exit(r.status\u003c500?0:1)).catch(()=\u003eprocess.exit(1))"
        ],
        "timeout": "5s"
      },
      "image": "${POLY_APP_IMAGE:?}",
      "mem_limit": "768m",
      "networks": {
        "default": {},
        "edge-prod": {
          "aliases": [
            "prod-web"
          ]
        }
      },
      "read_only": true,
      "restart": "unless-stopped",
      "secrets": [
        {
          "source": "db_password_app__web",
          "target": "db_password_app"
        },
        {
          "source": "plaid_secret__web",
          "target": "plaid_secret"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "ulimits": {
        "core": 0
      },
      "user": "10001:10001"
    },
    "worker": {
      "cap_drop": [
        "ALL"
      ],
      "env_file": [
        {
          "path": "/etc/polycarpic/host.env",
          "required": true
        }
      ],
      "environment": {
        "APP_ENV": "production",
        "DATABASE_HOST": "postgres",
        "DATABASE_NAME": "polycarpic",
        "DATABASE_PASSWORD_FILE": "/run/secrets/db_password_worker",
        "DATABASE_PORT": "5432",
        "DATABASE_SSLMODE": "disable",
        "DATABASE_USER": "poly_worker",
        "PLAID_ENV": "production",
        "RESEND_API_KEY_FILE": "/run/secrets/resend_api_key"
      },
      "healthcheck": {
        "interval": "60s",
        "test": [
          "CMD",
          "node",
          "-e",
          "process.exit(0)"
        ],
        "timeout": "5s"
      },
      "image": "${POLY_APP_IMAGE:?}",
      "mem_limit": "768m",
      "networks": {
        "default": null
      },
      "read_only": true,
      "restart": "unless-stopped",
      "secrets": [
        {
          "source": "db_password_worker__worker",
          "target": "db_password_worker"
        },
        {
          "source": "credential_keyring__worker",
          "target": "credential_keyring"
        },
        {
          "source": "resend_api_key__worker",
          "target": "resend_api_key"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "ulimits": {
        "core": 0
      },
      "user": "10002:10002"
    }
  },
  "x-app-image": "${POLY_APP_IMAGE:?}",
  "x-hardened": {
    "cap_drop": [
      "ALL"
    ],
    "read_only": true,
    "restart": "unless-stopped",
    "security_opt": [
      "no-new-privileges:true"
    ],
    "ulimits": {
      "core": 0
    }
  }
}