{
  "name": "polycarpic-staging",
  "networks": {
    "default": {
      "name": "polycarpic-staging_default",
      "ipam": {
        "config": [
          {
            "subnet": "10.202.1.0/24"
          }
        ]
      }
    },
    "edge-staging": {
      "name": "polycarpic-edge-staging",
      "ipam": {},
      "external": true
    }
  },
  "secrets": {
    "auth_secret__auth": {
      "name": "polycarpic-staging_auth_secret__auth",
      "file": "/etc/polycarpic/staging-secrets/auth/auth_secret"
    },
    "credential_keyring__worker": {
      "name": "polycarpic-staging_credential_keyring__worker",
      "file": "/etc/polycarpic/staging-secrets/worker/credential_keyring"
    },
    "db_password_app__web": {
      "name": "polycarpic-staging_db_password_app__web",
      "file": "/etc/polycarpic/staging-secrets/web/db_password_app"
    },
    "db_password_auth__auth": {
      "name": "polycarpic-staging_db_password_auth__auth",
      "file": "/etc/polycarpic/staging-secrets/auth/db_password_auth"
    },
    "db_password_worker__worker": {
      "name": "polycarpic-staging_db_password_worker__worker",
      "file": "/etc/polycarpic/staging-secrets/worker/db_password_worker"
    },
    "db_superuser_password__postgres": {
      "name": "polycarpic-staging_db_superuser_password__postgres",
      "file": "/etc/polycarpic/staging-secrets/postgres/db_superuser_password"
    },
    "plaid_secret__web": {
      "name": "polycarpic-staging_plaid_secret__web",
      "file": "/etc/polycarpic/staging-secrets/web/plaid_secret"
    },
    "resend_api_key__auth": {
      "name": "polycarpic-staging_resend_api_key__auth",
      "file": "/etc/polycarpic/staging-secrets/auth/resend_api_key"
    },
    "resend_api_key__worker": {
      "name": "polycarpic-staging_resend_api_key__worker",
      "file": "/etc/polycarpic/staging-secrets/worker/resend_api_key"
    }
  },
  "services": {
    "auth": {
      "restart": "unless-stopped",
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "auth"
      ],
      "entrypoint": null,
      "environment": {
        "APP_ENV": "staging",
        "AUTH_PUBLIC_PORT": "3000",
        "AUTH_SECRET_FILE": "/run/secrets/auth_secret",
        "DATABASE_HOST": "postgres",
        "DATABASE_NAME": "polycarpic",
        "DATABASE_PASSWORD_FILE": "/run/secrets/db_password_auth",
        "DATABASE_PORT": "5432",
        "DATABASE_SSLMODE": "disable",
        "DATABASE_USER": "poly_auth",
        "RESEND_API_KEY_FILE": "/run/secrets/resend_api_key"
      },
      "image": "ghcr.io/richmosko/polycarpic@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
      "mem_limit": "201326592",
      "networks": {
        "default": {},
        "edge-staging": {
          "aliases": [
            "staging-auth"
          ]
        }
      },
      "read_only": true,
      "secrets": [
        {
          "source": "db_password_auth__auth",
          "target": "db_password_auth"
        },
        {
          "source": "auth_secret__auth",
          "target": "auth_secret"
        },
        {
          "source": "resend_api_key__auth",
          "target": "resend_api_key"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "ulimits": {
        "core": {}
      },
      "user": "10107:10107",
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3000/api/auth/ok',{headers:{'x-forwarded-for':'127.0.0.1'}}).then(r=\u003eprocess.exit(r.status\u003c500?0:1)).catch(()=\u003eprocess.exit(1))"
        ],
        "timeout": "5s",
        "interval": "30s"
      }
    },
    "postgres": {
      "restart": "unless-stopped",
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "postgres",
        "-c",
        "config_file=/etc/postgresql/postgresql.conf"
      ],
      "entrypoint": null,
      "environment": {
        "POSTGRES_PASSWORD_FILE": "/run/secrets/db_superuser_password"
      },
      "image": "ghcr.io/richmosko/polycarpic-postgres@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "mem_limit": "1073741824",
      "networks": {
        "default": null
      },
      "read_only": true,
      "secrets": [
        {
          "source": "db_superuser_password__postgres",
          "target": "db_superuser_password"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp",
        "/var/run/postgresql:uid=999,gid=999,mode=0755"
      ],
      "ulimits": {
        "core": {}
      },
      "user": "999:999",
      "volumes": [
        {
          "type": "bind",
          "source": "/srv/polycarpic/pg-staging",
          "target": "/var/lib/postgresql/data",
          "bind": {}
        },
        {
          "type": "bind",
          "source": "@@REL@@/infra/postgres/postgresql.staging.conf",
          "target": "/etc/postgresql/postgresql.conf",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "@@REL@@/infra/postgres/pg_hba.staging.conf",
          "target": "/etc/postgresql/pg_hba.conf",
          "read_only": true,
          "bind": {}
        }
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U postgres -h /var/run/postgresql"
        ],
        "timeout": "5s",
        "interval": "10s",
        "retries": 6,
        "start_period": "30s"
      }
    },
    "web": {
      "restart": "unless-stopped",
      "cap_drop": [
        "ALL"
      ],
      "command": null,
      "entrypoint": null,
      "environment": {
        "APP_ENV": "staging",
        "DATABASE_HOST": "postgres",
        "DATABASE_NAME": "polycarpic",
        "DATABASE_PASSWORD_FILE": "/run/secrets/db_password_app",
        "DATABASE_PORT": "5432",
        "DATABASE_SSLMODE": "disable",
        "DATABASE_USER": "poly_app"
      },
      "image": "ghcr.io/richmosko/polycarpic@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
      "mem_limit": "402653184",
      "networks": {
        "default": {},
        "edge-staging": {
          "aliases": [
            "staging-web"
          ]
        }
      },
      "read_only": true,
      "secrets": [
        {
          "source": "db_password_app__web",
          "target": "db_password_app"
        },
        {
          "source": "plaid_secret__web",
          "target": "plaid_secret"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "ulimits": {
        "core": {}
      },
      "user": "10101:10101",
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3000/').then(r=\u003eprocess.exit(r.status\u003c500?0:1)).catch(()=\u003eprocess.exit(1))"
        ],
        "timeout": "5s",
        "interval": "30s"
      }
    },
    "worker": {
      "restart": "unless-stopped",
      "cap_drop": [
        "ALL"
      ],
      "command": null,
      "entrypoint": null,
      "environment": {
        "APP_ENV": "staging",
        "DATABASE_HOST": "postgres",
        "DATABASE_NAME": "polycarpic",
        "DATABASE_PASSWORD_FILE": "/run/secrets/db_password_worker",
        "DATABASE_PORT": "5432",
        "DATABASE_SSLMODE": "disable",
        "DATABASE_USER": "poly_worker",
        "RESEND_API_KEY_FILE": "/run/secrets/resend_api_key"
      },
      "image": "ghcr.io/richmosko/polycarpic@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
      "mem_limit": "402653184",
      "networks": {
        "default": null
      },
      "read_only": true,
      "secrets": [
        {
          "source": "db_password_worker__worker",
          "target": "db_password_worker"
        },
        {
          "source": "credential_keyring__worker",
          "target": "credential_keyring"
        },
        {
          "source": "resend_api_key__worker",
          "target": "resend_api_key"
        }
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "ulimits": {
        "core": {}
      },
      "user": "10102:10102",
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "process.exit(0)"
        ],
        "timeout": "5s",
        "interval": "1m0s"
      }
    }
  },
  "x-app-image": "ghcr.io/richmosko/polycarpic@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
  "x-hardened": {
    "cap_drop": [
      "ALL"
    ],
    "read_only": true,
    "restart": "unless-stopped",
    "security_opt": [
      "no-new-privileges:true"
    ],
    "ulimits": {
      "core": 0
    }
  }
}