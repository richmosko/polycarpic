#!/bin/sh
# The image entrypoint (POLY-85 R5): polycarpic web|worker|migrate|cli|status [args...]
# One image, three services (ARCH 8.1); compose sets `command: ["web"]` and so on.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cmd=${1:-}
[ "$#" -gt 0 ] && shift
case "$cmd" in
  web)     exec node "$here/apps/web/src/main.ts" "$@" ;;
  worker)  exec node "$here/apps/worker/src/main.ts" "$@" ;;
  migrate) exec node "$here/apps/migrate/src/cli.ts" "$@" ;;
  cli)     exec node "$here/apps/worker/src/cli/main.ts" "$@" ;;
  status)  exec node "$here/apps/web/src/ops/cli-status.ts" "$@" ;;
  *)
    echo "usage: polycarpic web|worker|migrate|cli|status [args...]" >&2
    exit 64
    ;;
esac
