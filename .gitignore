# Secrets — never commit
.env
.env.*
!.env.example

# Local working files (planning drafts, scratch)
temp/

# Claude Code: worktrees are pointers, not artifacts; personal settings overrides
.claude/worktrees/
.claude/settings.local.json
.claude/linear-team.json

# Agent memory: session-derived working memory, per-machine — not ratified project state
**/.claude/agent-memory/

# OS noise
.DS_Store
Thumbs.db

# Editor noise
*.swp
*.swo
.vscode/
.idea/

# Dependencies (any language)
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# Build artifacts
dist/
build/
out/
.next/
.nuxt/

# PT-54 (architect ruling §3): the dashboard's built output IS committed —
# a fresh clone must run `python3 scripts/cairn/cairn serve` with nothing
# but python3, so /dashboard can't depend on `npm ci` having ever run.
# Negation must come after the `dist/` line above (git precedence).
!scripts/cairn/dashboard/dist/

# Test artifacts
coverage/
.nyc_output/

# Logs
*.log
logs/

# PT-78/PT-86/POLY-4 (team-lead ruling, process/cairn/issues/POLY-4.md
# @ 5495132, extended per the follow-up ruling to cover token-usage.jsonl
# too): process/cairn/metrics/ is a nested git worktree of the orphan
# `metrics` branch (see WORKFLOW.md -> Metrics branch) -- never merged
# into this branch, bootstrapped idempotently by
# scripts/cairn/ensure_metrics_worktree.py. Every file under it --
# test-runs.jsonl, token-usage.jsonl, the receiver's pidfile/.lock, its
# .sessions/ bookkeeping -- lives there now, never tracked here.
*.pid
process/cairn/metrics/

# Vendored third-party assets (e.g. Mermaid bundle from scripts/vendor-mermaid.sh).
# Downstream projects that want this committed can un-ignore in their own .gitignore.
docs/_assets/vendor/

# Doc review notes (sidecar comments addressed by /refine-doc).
# In-process working artifacts; the resolution is the doc edits committed via PR.
docs/*/comments.md
